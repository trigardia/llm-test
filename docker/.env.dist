# Clé secrète Open WebUI
WEBUI_SECRET_KEY=

# URL Ollama natif (macOS host) — ne pas modifier
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Clé secrète SearXNG
SEARXNG_SECRET_KEY=
